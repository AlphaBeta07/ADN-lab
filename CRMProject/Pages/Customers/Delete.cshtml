@page
@model CRMProject.Pages.Customers.Delete
@{
    ViewData["Title"] = "Delete";
}

<h1>@ViewData["Title"]</h1>

<div class="mx-auto rounded border p-4" style="width: 400px;">
    <h3>Are you sure you want to delete this customer?</h3>

    <p><strong>Customer Id:</strong> @Model.CustomerId</p>

    <form method="post">
        
        <!-- IMPORTANT: Hidden field to send ID in POST -->
        <input type="hidden" asp-for="CustomerId" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Customers/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>